## Detailed Implementation

### 1. Client-Side Barcode Generation

**Option A: Use JsBarcode (CDN)**

```javascript
// In Vue component
import { onMounted } from 'vue';

onMounted(() => {
  // Generate all barcodes after DOM is ready
  document.querySelectorAll('.barcode').forEach((svg) => {
    JsBarcode(svg, svg.dataset.code, {
      format: 'CODE39', // Or CODE128 from settings
      width: 2,
      height: 50,
      displayValue: false // We'll show text separately
    });
  });
});
```

**Template**:
```html
<svg class="barcode" :data-code="borrower.barcode"></svg>
```

**Option B: Inline SVG generation** (no external library)
- More complex but no CDN dependency
- Could adapt python-barcode logic to JavaScript

**Recommendation**: Use JsBarcode (simpler, proven)

### 2. Borrower Reference Sheet Component

**File**: `src/bcd_web_vue/js/pages/PrintBorrowerReference.js`

```javascript
import { ref, onMounted, computed } from 'vue';
import { useRoute } from 'vue-router';

export default {
  name: 'PrintBorrowerReference',
  setup() {
    const route = useRoute();
    const borrowers = ref([]);
    const loading = ref(true);

    const borrowersByClass = computed(() => {
      // Group borrowers by class name
      const grouped = {};
      borrowers.value.forEach(b => {
        const className = b.class_name || 'Sans Classe';
        if (!grouped[className]) {
          grouped[className] = [];
        }
        grouped[className].push(b);
      });
      return grouped;
    });

    onMounted(async () => {
      // Parse query params (e.g., ?class_ids=1,2,3)
      const classIds = route.query.class_ids;

      // Fetch borrowers from existing API
      const params = new URLSearchParams({
        limit: 500, // Max borrowers
        ...(classIds && { class_id: classIds })
      });

      const response = await fetch(`/api/v1/borrowers?${params}`);
      const data = await response.json();
      borrowers.value = data.borrowers;
      loading.value = false;

      // Generate barcodes after data loads
      setTimeout(() => {
        document.querySelectorAll('.barcode').forEach((svg) => {
          JsBarcode(svg, svg.dataset.code, {
            format: 'CODE39',
            width: 2,
            height: 50,
            displayValue: false
          });
        });
      }, 100);
    });

    return {
      borrowers,
      borrowersByClass,
      loading
    };
  },
  template: `
    <div class="print-page">
      <div v-if="loading" class="loading">Loading...</div>

      <div v-else>
        <div
          v-for="(students, className) in borrowersByClass"
          :key="className"
          class="class-section"
        >
          <h1 class="class-header">{{ className }}</h1>

          <div
            v-for="student in students"
            :key="student.id"
            class="borrower-row"
          >
            <div class="borrower-id">{{ student.borrower_id }}</div>

            <div class="borrower-barcode">
              <svg class="barcode" :data-code="student.barcode"></svg>
              <div class="barcode-text">{{ student.barcode }}</div>
            </div>

            <div class="borrower-name">{{ student.full_name }}</div>

            <div class="borrower-status">
              {{ student.role === 'student' ? 'Élève' : student.role }}
            </div>
          </div>
        </div>
      </div>
    </div>
  `
};
```

