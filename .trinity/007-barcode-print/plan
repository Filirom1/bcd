export default {
  name: 'PrintStudentCards',
  setup() {
    const borrowers = ref([]);
    const settings = ref(null);

    onMounted(async () => {
      // Fetch borrowers
      const params = new URLSearchParams({ limit: 500 });
      const response = await fetch(`/api/v1/borrowers?${params}`);
      const data = await response.json();
      borrowers.value = data.borrowers;

      // Fetch system settings for library name
      const settingsRes = await fetch('/api/v1/admin/settings');
      settings.value = await settingsRes.json();

      // Generate barcodes
      setTimeout(() => {
        document.querySelectorAll('.barcode').forEach((svg) => {
          JsBarcode(svg, svg.dataset.code, {
            format: 'CODE39',
            width: 1.5,
            height: 40,
            displayValue: false
          });
        });
      }, 100);
    });

    return { borrowers, settings };
  },
  template: `
    <div class="print-page">
      <div class="card-grid">
        <div
          v-for="student in borrowers"
          :key="student.id"
          class="library-card"
        >
          <div class="card-header">
            {{ settings?.library_name || 'BCD' }}
            <span v-if="student.class_name"> - {{ student.class_name }}</span>
          </div>

          <div class="card-body">
            <div class="card-photo">
              <!-- Photo placeholder -->
            </div>

            <div class="card-info">
              <div class="card-name">{{ student.full_name }}</div>
              <div class="card-id">{{ student.borrower_id }}</div>
              <div class="card-role">{{ student.role === 'student' ? 'Élève' : student.role }}</div>
            </div>
          </div>

          <div class="card-barcode">
            <svg class="barcode" :data-code="student.barcode"></svg>
            <div class="barcode-text">{{ student.barcode }}</div>
          </div>
        </div>
      </div>
    </div>
  `
};
```

