[gd_scene format=3]

[ext_resource type="Script" path="res://src/components/HistoryEntry.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://src/components/CoverImage.tscn" id="2_cover"]

[node name="HistoryEntry" type="VBoxContainer"]
size_flags_horizontal = 3
theme_override_constants/separation = 6
script = ExtResource("1_script")

[node name="Row" type="HBoxContainer" parent="."]
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="CoverZone" type="Control" parent="Row"]
custom_minimum_size = Vector2(44, 60)

[node name="CoverImage" parent="Row/CoverZone" instance=ExtResource("2_cover")]
unique_name_in_owner = true
visible = false
anchor_right = 1.0
anchor_bottom = 1.0

[node name="CoverPlaceholder" type="Label" parent="Row/CoverZone"]
unique_name_in_owner = true
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
theme_type_variation = "LabelLarge"
text = "📖"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Info" type="VBoxContainer" parent="Row"]
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="TitleRow" type="HBoxContainer" parent="Row/Info"]
theme_override_constants/separation = 6

[node name="SuccessLabel" type="Label" parent="Row/Info/TitleRow"]
unique_name_in_owner = true
text = "✓"
theme_type_variation = "LabelSuccess"

[node name="TitleLabel" type="Label" parent="Row/Info/TitleRow"]
unique_name_in_owner = true
size_flags_horizontal = 3
autowrap_mode = 3
theme_type_variation = "LabelMedium"

[node name="StatusLabel" type="Label" parent="Row/Info"]
unique_name_in_owner = true
size_flags_horizontal = 3
theme_type_variation = "LabelSuccess"

[node name="BorrowerLabel" type="Label" parent="Row/Info"]
unique_name_in_owner = true
size_flags_horizontal = 3
theme_type_variation = "LabelSmall"

[node name="LocationRow" type="HBoxContainer" parent="Row/Info"]
unique_name_in_owner = true
theme_override_constants/separation = 6

[node name="LocationLabel" type="Label" parent="Row/Info/LocationRow"]
unique_name_in_owner = true
text = ""
theme_type_variation = "LabelSmall"

[node name="Badges" type="HBoxContainer" parent="Row/Info/LocationRow"]
unique_name_in_owner = true
theme_override_constants/separation = 4

[node name="Divider" type="HSeparator" parent="."]
theme_override_colors/separator_color = Color(0.84, 0.87, 0.91, 0.7)
